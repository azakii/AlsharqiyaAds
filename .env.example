# MySQL — على Hostinger استخدم 127.0.0.1 وبيانات قاعدة البيانات من hPanel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# مجلد الصور المرفوعة (اختياري). على Hostinger اجعله خارج مجلد التطبيق عشان ما يتمسحش مع كل نشر.
# UPLOAD_DIR=/home/USER/uploads

# إيميل استعادة كلمة المرور (SMTP). بدونه الرابط يُطبع في لوج السيرفر فقط.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# بيانات دخول لوحة الإدارة
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Sharqiah@2026
